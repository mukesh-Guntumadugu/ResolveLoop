[Unit]
Description=ResolveLoop orchestrator API (eGain hackathon prototype)
After=network.target

[Service]
WorkingDirectory=/root/resolveloop
EnvironmentFile=/root/resolveloop/.env
ExecStart=/root/resolveloop/.venv/bin/uvicorn server.main:app --host 127.0.0.1 --port 8790 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
